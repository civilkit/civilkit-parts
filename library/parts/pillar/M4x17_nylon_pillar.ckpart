},{"id":"p3","x":1.44338,"y":2.5},{"id":"p4","x":-1.44338,"y":2.5},{"id":"p5","x":-2.88675,"y":0},{"id":"p6","x":-1.44338,"y":-2.5},{"id":"p7","x":1.44338,"y":-2.5}],"entities":[{"id":"e1","type":"circle","c":"p1","r":4},{"id":"e2","type":"line","p1":"p2","p2":"p3"},{"id":"e3","type":"line","p1":"p3","p2":"p4"},{"id":"e4","type":"line","p1":"p4","p2":"p5"},{"id":"e5","type":"line","p1":"p5","p2":"p6"},{"id":"e6","type":"line","p1":"p6","p2":"p7"},{"id":"e7","type":"line","p1":"p7","p2":"p2"}],"constraints":[],"group":"M4x17_nylon_pillar"},{"type":"extrude","op":"newBody","body":"b4","sketch":"F8","end":"blind","depth":"=pillar_height","id":"F9","group":"M4x17_nylon_pillar"},{"type":"combine","op":"union","target":{"body":"b1"},"tools":[{"body":"b2"},{"body":"b3"},{"body":"b4"}],"id":"F10","group":"M4x17_nylon_pillar"}],"seq":11,"rollback":null,"variables":[{"name":"pillar_bot_thread","expr":"6"},{"name":"pillar_height","expr":"20"},{"name":"pillar_top_thread","expr":"-6"}],"script":"// pillar(M4x17_nylon_pillar) from NopSCADlib 00ec289 (GPL-3.0-or-later); see ../NOTICE.md\n// Generated by openscad_to_ckpart.py. Edit freely: running this script rebuilds the feature history.\nvariables({ pillar_bot_thread: 6, pillar_height: 20, pillar_top_thread: -6 });\nconst p = part(\"M4x17_nylon_pillar\");\ngroup(\"M4x17_nylon_pillar\", () => {\n  p\n    .sketch('front', (s) => { s.circle(2, [0, 0]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b1\", \"sketch\": \"$sketch\", \"end\": \"blind\", \"depth\": \"=pillar_bot_thread\"})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b1\"}], \"translate\": [0.0, 0.0, \"=((-pillar_bot_thread)+0.0078125)\"]})\n    .sketch('front', (s) => { s.circle(2, [0, 0]); s.polygon([[2.88675, 0], [1.44338, 2.5], [-1.44338, 2.5], [-2.88675, 0], [-1.44338, -2.5], [1.44338, -2.5]]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b2\", \"sketch\": \"$sketch\", \"end\": \"blind\", \"depth\": \"=pillar_height\"})\n    .sketch('front', (s) => { s.circle(2.00391, [0, 0]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b3\", \"sketch\": \"$sketch\", \"end\": \"blind\", \"depth\": \"=((pillar_height+pillar_top_thread)--0)\"})\n    .sketch('front', (s) => { s.circle(4, [0, 0]); s.polygon([[2.88675, 0], [1.44338, 2.5], [-1.44338, 2.5], [-2.88675, 0], [-1.44338, -2.5], [1.44338, -2.5]]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b4\", \"sketch\": \"$sketch\", \"end\": \"blind\", \"depth\": \"=pillar_height\"})\n    .combine('union', \"b1\", [\"b2\", \"b3\", \"b4\"])\n    .appearance({ feature: 'F2', colour: '#ffdc64' })\n    .appearance({ feature: 'F5', colour: '#ffdc64' })\n    .appearance({ feature: 'F7', colour: '#ffdc64' })\n    .appearance({ feature: 'F9', colour: '#ffffff' });\n});\n","appearance":{"F2":{"color":"#ffdc64"},"F5":{"color":"#ffdc64"},"F7":{"color":"#ffdc64"},"F9":{"color":"#ffffff"}},"license":"GPL-3.0-or-later","source":"https://github.com/nophead/NopSCADlib/blob/00ec289/vitamins/pillar.scad"}