{"format":"ck-part","version":1,"name":"GT2x20_plain_idler","features":[{"type":"sketch","id":"F1","plane":{"kind":"std","id":"front"},"points":[{"id":"O","x":0,"y":0,"fixed":true},{"id":"p1","x":2,"y":0},{"id":"p2","x":9,"y":0},{"id":"p3","x":9,"y":1},{"id":"p4","x":2,"y":1},{"id":"p5","x":0,"y":0},{"id":"p6","x":0,"y":1}],"entities":[{"id":"e1","type":"line","p1":"p1","p2":"p2"},{"id":"e2","type":"line","p1":"p2","p2":"p3"},{"id":"e3","type":"line","p1":"p3","p2":"p4"},{"id":"e4","type":"line","p1":"p4","p2":"p1"},{"id":"ax","type":"line","p1":"p5","p2":"p6"}],"constraints":[],"group":"GT2x20_plain_idler"},{"type":"revolve","op":"newBody","body":"b1","sketch":"F1","axis":"ax","end":"blind","angle":360,"id":"F2","group":"GT2x20_plain_idler"},{"type":"moveBody","bodies":[{"body":"b1"}],"rotate":{"axis":"x","origin":[0,0,0],"angle":90},"id":"F3","group":"GT2x20_plain_idler"},{"type":"sketch","id":"F4","plane":{"kind":"std","id":"front"},"points":[{"id":"O","x":0,"y":0,"fixed":true},{"id":"p1","x":2,"y":7.5},{"id":"p2","x":9,"y":7.5},{"id":"p3","x":9,"y":8.5},{"id":"p4","x":2,"y":8.5},{"id":"p5","x":0,"y":0},{"id":"p6","x":0,"y":1}],"entities":[{"id":"e1","type":"line","p1":"p1","p2":"p2"},{"id":"e2","type":"line","p1":"p2","p2":"p3"},{"id":"e3","type":"line","p1":"p3","p2":"p4"},{"id":"e4","type":"line","p1":"p4","p2":"p1"},{"id":"ax","type":"line","p1":"p5","p2":"p6"}],"constraints":[],"group":"GT2x20_plain_idler"},{"type":"revolve","op":"newBody","body":"b2","sketch":"F4","axis":"ax","end":"blind","angle":360,"id":"F5","group":"GT2x20_plain_idler"},{"type":"moveBody","bodies":[{"body":"b2"}],"rotate":{"axis":"x","origin":[0,0,0],"angle":90},"id":"F6","group":"GT2x20_plain_idler"},{"type":"combine","op":"union","target":{"body":"b1"},"tools":[{"body":"b2"}],"id":"F7","group":"GT2x20_plain_idler"},{"type":"sketch","id":"F8","plane":{"kind":"std","id":"front"},"points":[{"id":"O","x":0,"y":0,"fixed":true},{"id":"p1","x":0,"y":0},{"id":"p2","x":0,"y":0}],"entities":[{"id":"e1","type":"circle","c":"p1","r":6},{"id":"e2","type":"circle","c":"p2","r":2}],"constraints":[],"group":"GT2x20_plain_idler"},{"type":"extrude","op":"newBody","body":"b3","sketch":"F8","end":"blind","depth":"=pulley_width","id":"F9","group":"GT2x20_plain_idler"},{"type":"moveBody","bodies":[{"body":"b3"}],"translate":[0,0,"=(pulley_hub_length+pulley_flange_thickness)"],"id":"F10","group":"GT2x20_plain_idler"},{"type":"combine","op":"union","target":{"body":"b1"},"tools":[{"body":"b2"},{"body":"b3"}],"id":"F11","group":"GT2x20_plain_idler"}],"seq":12,"rollback":null,"variables":[{"name":"pulley_flange_thickness","expr":"1"},{"name":"pulley_hub_length","expr":"0"},{"name":"pulley_width","expr":"6.5"}],"script":"// pulley(GT2x20_plain_idler) from NopSCADlib 00ec289 (GPL-3.0-or-later); see ../NOTICE.md\n// Generated by openscad_to_ckpart.py. Edit freely: running this script rebuilds the feature history.\nvariables({ pulley_flange_thickness: 1, pulley_hub_length: 0, pulley_width: 6.5 });\nconst p = part(\"GT2x20_plain_idler\");\ngroup(\"GT2x20_plain_idler\", () => {\n  p\n    .sketchFeature('front', {\"points\": [{\"id\": \"O\", \"x\": 0, \"y\": 0, \"fixed\": true}, {\"id\": \"p1\", \"x\": 2.0, \"y\": 0.0}, {\"id\": \"p2\", \"x\": 9.0, \"y\": 0.0}, {\"id\": \"p3\", \"x\": 9.0, \"y\": 1.0}, {\"id\": \"p4\", \"x\": 2.0, \"y\": 1.0}, {\"id\": \"p5\", \"x\": 0.0, \"y\": 0.0}, {\"id\": \"p6\", \"x\": 0.0, \"y\": 1.0}], \"entities\": [{\"id\": \"e1\", \"type\": \"line\", \"p1\": \"p1\", \"p2\": \"p2\"}, {\"id\": \"e2\", \"type\": \"line\", \"p1\": \"p2\", \"p2\": \"p3\"}, {\"id\": \"e3\", \"type\": \"line\", \"p1\": \"p3\", \"p2\": \"p4\"}, {\"id\": \"e4\", \"type\": \"line\", \"p1\": \"p4\", \"p2\": \"p1\"}, {\"id\": \"ax\", \"type\": \"line\", \"p1\": \"p5\", \"p2\": \"p6\"}]})\n    .feature({\"type\": \"revolve\", \"op\": \"newBody\", \"body\": \"b1\", \"sketch\": \"$sketch\", \"axis\": \"ax\", \"end\": \"blind\", \"angle\": 360.0})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b1\"}], \"rotate\": {\"axis\": \"x\", \"origin\": [0, 0, 0], \"angle\": 90.0}})\n    .sketchFeature('front', {\"points\": [{\"id\": \"O\", \"x\": 0, \"y\": 0, \"fixed\": true}, {\"id\": \"p1\", \"x\": 2.0, \"y\": 7.5}, {\"id\": \"p2\", \"x\": 9.0, \"y\": 7.5}, {\"id\": \"p3\", \"x\": 9.0, \"y\": 8.5}, {\"id\": \"p4\", \"x\": 2.0, \"y\": 8.5}, {\"id\": \"p5\", \"x\": 0.0, \"y\": 0.0}, {\"id\": \"p6\", \"x\": 0.0, \"y\": 1.0}], \"entities\": [{\"id\": \"e1\", \"type\": \"line\", \"p1\": \"p1\", \"p2\": \"p2\"}, {\"id\": \"e2\", \"type\": \"line\", \"p1\": \"p2\", \"p2\": \"p3\"}, {\"id\": \"e3\", \"type\": \"line\", \"p1\": \"p3\", \"p2\": \"p4\"}, {\"id\": \"e4\", \"type\": \"line\", \"p1\": \"p4\", \"p2\": \"p1\"}, {\"id\": \"ax\", \"type\": \"line\", \"p1\": \"p5\", \"p2\": \"p6\"}]})\n    .feature({\"type\": \"revolve\", \"op\": \"newBody\", \"body\": \"b2\", \"sketch\": \"$sketch\", \"axis\": \"ax\", \"end\": \"blind\", \"angle\": 360.0})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b2\"}], \"rotate\": {\"axis\": \"x\", \"origin\": [0, 0, 0], \"angle\": 90.0}})\n    .combine('union', \"b1\", [\"b2\"])\n    .sketch('front', (s) => { s.circle(6, [0, 0]); s.circle(2, [0, 0]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b3\", \"sketch\": \"$sketch\", \"end\": \"blind\", \"depth\": \"=pulley_width\"})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b3\"}], \"translate\": [0.0, 0.0, \"=(pulley_hub_length+pulley_flange_thickness)\"]})\n    .combine('union', \"b1\", [\"b2\", \"b3\"])\n    .appearance({ feature: 'F2', colour: '#bfbfbf' })\n    .appearance({ feature: 'F5', colour: '#bfbfbf' })\n    .appearance({ feature: 'F9', colour: '#bfbfbf' });\n});\n","appearance":{"F2":{"color":"#bfbfbf"},"F5":{"color":"#bfbfbf"},"F9":{"color":"#bfbfbf"}},"license":"GPL-3.0-or-later","source":"https://github.com/nophead/NopSCADlib/blob/00ec289/vitamins/pulley.scad"}