{"format":"ck-part","version":1,"name":"LM4LUU","features":[{"type":"sketch","id":"F1","plane":{"kind":"std","id":"front"},"points":[{"id":"O","x":0,"y":0,"fixed":true},{"id":"p1","x":0,"y":0},{"id":"p2","x":0,"y":0}],"entities":[{"id":"e1","type":"circle","c":"p1","r":4},{"id":"e2","type":"circle","c":"p2","r":3.6}],"constraints":[],"group":"LM4LUU"},{"type":"extrude","op":"newBody","body":"b1","sketch":"F1","end":"mid","depth":"=bearing_length","id":"F2","group":"LM4LUU"},{"type":"sketch","id":"F3","plane":{"kind":"std","id":"front"},"points":[{"id":"O","x":0,"y":0,"fixed":true},{"id":"p1","x":0,"y":0},{"id":"p2","x":0,"y":0}],"entities":[{"id":"e1","type":"circle","c":"p1","r":3.6},{"id":"e2","type":"circle","c":"p2","r":2.00781}],"constraints":[],"group":"LM4LUU"},{"type":"extrude","op":"newBody","body":"b2","sketch":"F3","end":"mid","depth":"=(bearing_length-0.5)","id":"F4","group":"LM4LUU"},{"type":"sketch","id":"F5","plane":{"kind":"std","id":"front"},"points":[{"id":"O","x":0,"y":0,"fixed":true},{"id":"p1","x":0,"y":0},{"id":"p2","x":0,"y":0}],"entities":[{"id":"e1","type":"circle","c":"p1","r":2.24},{"id":"e2","type":"circle","c":"p2","r":2}],"constraints":[],"group":"LM4LUU"},{"type":"extrude","op":"newBody","body":"b3","sketch":"F5","end":"mid","depth":"=bearing_length","id":"F6","group":"LM4LUU"},{"type":"combine","op":"union","target":{"body":"b1"},"tools":[{"body":"b2"},{"body":"b3"}],"id":"F7","group":"LM4LUU"}],"seq":8,"rollback":null,"variables":[{"name":"bearing_length","expr":"23"}],"script":"// linear_bearing(LM4LUU) from NopSCADlib 00ec289 (GPL-3.0-or-later); see ../NOTICE.md\n// Generated by openscad_to_ckpart.py. Edit freely: running this script rebuilds the feature history.\nvariables({ bearing_length: 23 });\nconst p = part(\"LM4LUU\");\ngroup(\"LM4LUU\", () => {\n  p\n    .sketch('front', (s) => { s.circle(4, [0, 0]); s.circle(3.6, [0, 0]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b1\", \"sketch\": \"$sketch\", \"end\": \"mid\", \"depth\": \"=bearing_length\"})\n    .sketch('front', (s) => { s.circle(3.6, [0, 0]); s.circle(2.00781, [0, 0]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b2\", \"sketch\": \"$sketch\", \"end\": \"mid\", \"depth\": \"=(bearing_length-0.5)\"})\n    .sketch('front', (s) => { s.circle(2.24, [0, 0]); s.circle(2, [0, 0]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b3\", \"sketch\": \"$sketch\", \"end\": \"mid\", \"depth\": \"=bearing_length\"})\n    .combine('union', \"b1\", [\"b2\", \"b3\"])\n    .appearance({ feature: 'F2', colour: '#b3b3b3' })\n    .appearance({ feature: 'F4', colour: '#4c4c4c' })\n    .appearance({ feature: 'F6', colour: '#3d3d3d' });\n});\n","appearance":{"F2":{"color":"#b3b3b3"},"F4":{"color":"#4c4c4c"},"F6":{"color":"#3d3d3d"}},"license":"GPL-3.0-or-later","source":"https://github.com/nophead/NopSCADlib/blob/00ec289/vitamins/linear_bearing.scad"}