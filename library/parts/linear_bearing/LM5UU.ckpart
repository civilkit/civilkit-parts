,"op":"newBody","body":"b4","sketch":"F9","end":"blind","depth":"=bearing_groove_length","id":"F10","group":"LM5UU"},{"type":"moveBody","bodies":[{"body":"b4"}],"translate":[0,0,"=((((bearing_length-bearing_groove_spacing)/2)+bearing_groove_spacing)-bearing_groove_length)"],"id":"F11","group":"LM5UU"},{"type":"sketch","id":"F12","plane":{"kind":"std","id":"front"},"points":[{"id":"O","x":0,"y":0,"fixed":true},{"id":"p1","x":0,"y":0},{"id":"p2","x":0,"y":0}],"entities":[{"id":"e1","type":"circle","c":"p1","r":5},{"id":"e2","type":"circle","c":"p2","r":4.5}],"constraints":[],"group":"LM5UU"},{"type":"extrude","op":"newBody","body":"b5","sketch":"F12","end":"blind","depth":"=((bearing_length-bearing_groove_spacing)/2)","id":"F13","group":"LM5UU"},{"type":"moveBody","bodies":[{"body":"b5"}],"translate":[0,0,"=(((bearing_length-bearing_groove_spacing)/2)+bearing_groove_spacing)"],"id":"F14","group":"LM5UU"},{"type":"combine","op":"union","target":{"body":"b1"},"tools":[{"body":"b2"},{"body":"b3"},{"body":"b4"},{"body":"b5"}],"id":"F15","group":"LM5UU"},{"type":"moveBody","bodies":[{"body":"b1"}],"translate":[0,0,"=((-bearing_length)/2)"],"id":"F16","group":"LM5UU"},{"type":"sketch","id":"F17","plane":{"kind":"std","id":"front"},"points":[{"id":"O","x":0,"y":0,"fixed":true},{"id":"p1","x":0,"y":0},{"id":"p2","x":0,"y":0}],"entities":[{"id":"e1","type":"circle","c":"p1","r":4.5},{"id":"e2","type":"circle","c":"p2","r":2.50781}],"constraints":[],"group":"LM5UU"},{"type":"extrude","op":"newBody","body":"b6","sketch":"F17","end":"mid","depth":"=(bearing_length-0.5)","id":"F18","group":"LM5UU"},{"type":"sketch","id":"F19","plane":{"kind":"std","id":"front"},"points":[{"id":"O","x":0,"y":0,"fixed":true},{"id":"p1","x":0,"y":0},{"id":"p2","x":0,"y":0}],"entities":[{"id":"e1","type":"circle","c":"p1","r":2.8},{"id":"e2","type":"circle","c":"p2","r":2.5}],"constraints":[],"group":"LM5UU"},{"type":"extrude","op":"newBody","body":"b7","sketch":"F19","end":"mid","depth":"=bearing_length","id":"F20","group":"LM5UU"},{"type":"combine","op":"union","target":{"body":"b1"},"tools":[{"body":"b6"},{"body":"b7"}],"id":"F21","group":"LM5UU"}],"seq":22,"rollback":null,"variables":[{"name":"bearing_groove_length","expr":"1.1"},{"name":"bearing_groove_spacing","expr":"10.2"},{"name":"bearing_length","expr":"15"}],"script":"// linear_bearing(LM5UU) from NopSCADlib 00ec289 (GPL-3.0-or-later); see ../NOTICE.md\n// Generated by openscad_to_ckpart.py. Edit freely: running this script rebuilds the feature history.\nvariables({ bearing_groove_length: 1.1, bearing_groove_spacing: 10.2, bearing_length: 15 });\nconst p = part(\"LM5UU\");\ngroup(\"LM5UU\", () => {\n  p\n    .sketch('front', (s) => { s.circle(5, [0, 0]); s.circle(4.5, [0, 0]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b1\", \"sketch\": \"$sketch\", \"end\": \"blind\", \"depth\": \"=((bearing_length-bearing_groove_spacing)/2)\"})\n    .sketch('front', (s) => { s.circle(4.75, [0, 0]); s.circle(4.5, [0, 0]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b2\", \"sketch\": \"$sketch\", \"end\": \"blind\", \"depth\": \"=bearing_groove_length\"})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b2\"}], \"translate\": [0.0, 0.0, \"=((bearing_length-bearing_groove_spacing)/2)\"]})\n    .sketch('front', (s) => { s.circle(5, [0, 0]); s.circle(4.5, [0, 0]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b3\", \"sketch\": \"$sketch\", \"end\": \"blind\", \"depth\": \"=(bearing_groove_spacing-(2*bearing_groove_length))\"})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b3\"}], \"translate\": [0.0, 0.0, \"=(((bearing_length-bearing_groove_spacing)/2)+bearing_groove_length)\"]})\n    .sketch('front', (s) => { s.circle(4.75, [0, 0]); s.circle(4.5, [0, 0]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b4\", \"sketch\": \"$sketch\", \"end\": \"blind\", \"depth\": \"=bearing_groove_length\"})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b4\"}], \"translate\": [0.0, 0.0, \"=((((bearing_length-bearing_groove_spacing)/2)+bearing_groove_spacing)-bearing_groove_length)\"]})\n    .sketch('front', (s) => { s.circle(5, [0, 0]); s.circle(4.5, [0, 0]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b5\", \"sketch\": \"$sketch\", \"end\": \"blind\", \"depth\": \"=((bearing_length-bearing_groove_spacing)/2)\"})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b5\"}], \"translate\": [0.0, 0.0, \"=(((bearing_length-bearing_groove_spacing)/2)+bearing_groove_spacing)\"]})\n    .combine('union', \"b1\", [\"b2\", \"b3\", \"b4\", \"b5\"])\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b1\"}], \"translate\": [0.0, 0.0, \"=((-bearing_length)/2)\"]})\n    .sketch('front', (s) => { s.circle(4.5, [0, 0]); s.circle(2.50781, [0, 0]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b6\", \"sketch\": \"$sketch\", \"end\": \"mid\", \"depth\": \"=(bearing_length-0.5)\"})\n    .sketch('front', (s) => { s.circle(2.8, [0, 0]); s.circle(2.5, [0, 0]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b7\", \"sketch\": \"$sketch\", \"end\": \"mid\", \"depth\": \"=bearing_length\"})\n    .combine('union', \"b1\", [\"b6\", \"b7\"])\n    .appearance({ feature: 'F2', colour: '#b3b3b3' })\n    .appearance({ feature: 'F4', colour: '#999999' })\n    .appearance({ feature: 'F7', colour: '#b3b3b3' })\n    .appearance({ feature: 'F10', colour: '#999999' })\n    .appearance({ feature: 'F13', colour: '#b3b3b3' })\n    .appearance({ feature: 'F18', colour: '#4c4c4c' })\n    .appearance({ feature: 'F20', colour: '#3d3d3d' });\n});\n","appearance":{"F2":{"color":"#b3b3b3"},"F4":{"color":"#999999"},"F7":{"color":"#b3b3b3"},"F10":{"color":"#999999"},"F13":{"color":"#b3b3b3"},"F18":{"color":"#4c4c4c"},"F20":{"color":"#3d3d3d"}},"license":"GPL-3.0-or-later","source":"https://github.com/nophead/NopSCADlib/blob/00ec289/vitamins/linear_bearing.scad"}