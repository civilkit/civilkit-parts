, {\"id\": \"p1\", \"x\": 7.0, \"y\": -2.5}, {\"id\": \"p2\", \"x\": 7.833333333, \"y\": -2.5}, {\"id\": \"p3\", \"x\": 8.0, \"y\": -2.333333333}, {\"id\": \"p4\", \"x\": 8.0, \"y\": 2.333333333}, {\"id\": \"p5\", \"x\": 7.833333333, \"y\": 2.5}, {\"id\": \"p6\", \"x\": 7.0, \"y\": 2.5}, {\"id\": \"p7\", \"x\": 0.0, \"y\": 0.0}, {\"id\": \"p8\", \"x\": 0.0, \"y\": 1.0}], \"entities\": [{\"id\": \"e1\", \"type\": \"line\", \"p1\": \"p1\", \"p2\": \"p2\"}, {\"id\": \"e2\", \"type\": \"line\", \"p1\": \"p2\", \"p2\": \"p3\"}, {\"id\": \"e3\", \"type\": \"line\", \"p1\": \"p3\", \"p2\": \"p4\"}, {\"id\": \"e4\", \"type\": \"line\", \"p1\": \"p4\", \"p2\": \"p5\"}, {\"id\": \"e5\", \"type\": \"line\", \"p1\": \"p5\", \"p2\": \"p6\"}, {\"id\": \"e6\", \"type\": \"line\", \"p1\": \"p6\", \"p2\": \"p1\"}, {\"id\": \"ax\", \"type\": \"line\", \"p1\": \"p7\", \"p2\": \"p8\"}]})\n    .feature({\"type\": \"revolve\", \"op\": \"newBody\", \"body\": \"b1\", \"sketch\": \"$sketch\", \"axis\": \"ax\", \"end\": \"blind\", \"angle\": 360.0})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b1\"}], \"rotate\": {\"axis\": \"x\", \"origin\": [0, 0, 0], \"angle\": 90.0}})\n    .sketchFeature('front', {\"points\": [{\"id\": \"O\", \"x\": 0, \"y\": 0, \"fixed\": true}, {\"id\": \"p1\", \"x\": 7.0, \"y\": -2.5}, {\"id\": \"p2\", \"x\": 8.833333333, \"y\": -2.5}, {\"id\": \"p3\", \"x\": 9.0, \"y\": -2.333333333}, {\"id\": \"p4\", \"x\": 9.0, \"y\": -1.666666667}, {\"id\": \"p5\", \"x\": 8.833333333, \"y\": -1.5}, {\"id\": \"p6\", \"x\": 7.0, \"y\": -1.5}, {\"id\": \"p7\", \"x\": 0.0, \"y\": 0.0}, {\"id\": \"p8\", \"x\": 0.0, \"y\": 1.0}], \"entities\": [{\"id\": \"e1\", \"type\": \"line\", \"p1\": \"p1\", \"p2\": \"p2\"}, {\"id\": \"e2\", \"type\": \"line\", \"p1\": \"p2\", \"p2\": \"p3\"}, {\"id\": \"e3\", \"type\": \"line\", \"p1\": \"p3\", \"p2\": \"p4\"}, {\"id\": \"e4\", \"type\": \"line\", \"p1\": \"p4\", \"p2\": \"p5\"}, {\"id\": \"e5\", \"type\": \"line\", \"p1\": \"p5\", \"p2\": \"p6\"}, {\"id\": \"e6\", \"type\": \"line\", \"p1\": \"p6\", \"p2\": \"p1\"}, {\"id\": \"ax\", \"type\": \"line\", \"p1\": \"p7\", \"p2\": \"p8\"}]})\n    .feature({\"type\": \"revolve\", \"op\": \"newBody\", \"body\": \"b2\", \"sketch\": \"$sketch\", \"axis\": \"ax\", \"end\": \"blind\", \"angle\": 360.0})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b2\"}], \"rotate\": {\"axis\": \"x\", \"origin\": [0, 0, 0], \"angle\": 90.0}})\n    .sketchFeature('front', {\"points\": [{\"id\": \"O\", \"x\": 0, \"y\": 0, \"fixed\": true}, {\"id\": \"p1\", \"x\": 2.5, \"y\": -2.333333333}, {\"id\": \"p2\", \"x\": 2.666666667, \"y\": -2.5}, {\"id\": \"p3\", \"x\": 3.5, \"y\": -2.5}, {\"id\": \"p4\", \"x\": 3.5, \"y\": 2.5}, {\"id\": \"p5\", \"x\": 2.666666667, \"y\": 2.5}, {\"id\": \"p6\", \"x\": 2.5, \"y\": 2.333333333}, {\"id\": \"p7\", \"x\": 0.0, \"y\": 0.0}, {\"id\": \"p8\", \"x\": 0.0, \"y\": 1.0}], \"entities\": [{\"id\": \"e1\", \"type\": \"line\", \"p1\": \"p1\", \"p2\": \"p2\"}, {\"id\": \"e2\", \"type\": \"line\", \"p1\": \"p2\", \"p2\": \"p3\"}, {\"id\": \"e3\", \"type\": \"line\", \"p1\": \"p3\", \"p2\": \"p4\"}, {\"id\": \"e4\", \"type\": \"line\", \"p1\": \"p4\", \"p2\": \"p5\"}, {\"id\": \"e5\", \"type\": \"line\", \"p1\": \"p5\", \"p2\": \"p6\"}, {\"id\": \"e6\", \"type\": \"line\", \"p1\": \"p6\", \"p2\": \"p1\"}, {\"id\": \"ax\", \"type\": \"line\", \"p1\": \"p7\", \"p2\": \"p8\"}]})\n    .feature({\"type\": \"revolve\", \"op\": \"newBody\", \"body\": \"b3\", \"sketch\": \"$sketch\", \"axis\": \"ax\", \"end\": \"blind\", \"angle\": 360.0})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b3\"}], \"rotate\": {\"axis\": \"x\", \"origin\": [0, 0, 0], \"angle\": 90.0}})\n    .sketch('front', (s) => { s.circle(6.99219, [0, 0]); s.circle(3.50781, [0, 0]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b4\", \"sketch\": \"$sketch\", \"end\": \"mid\", \"depth\": \"=(bb_width-1)\"})\n    .combine('union', \"b1\", [\"b2\", \"b3\", \"b4\"])\n    .appearance({ feature: 'F2', colour: '#c0c0c0' })\n    .appearance({ feature: 'F5', colour: '#c0c0c0' })\n    .appearance({ feature: 'F8', colour: '#c0c0c0' })\n    .appearance({ feature: 'F11', colour: '#c0c0c0' });\n});\n","appearance":{"F2":{"color":"#c0c0c0"},"F5":{"color":"#c0c0c0"},"F8":{"color":"#c0c0c0"},"F11":{"color":"#c0c0c0"}},"license":"GPL-3.0-or-later","source":"https://github.com/nophead/NopSCADlib/blob/00ec289/vitamins/ball_bearing.scad"}