ketch\": \"$sketch\", \"end\": \"blind\", \"depth\": \"=leadnut_flange_t\"})\n    .sketch('front', (s) => { s.circle(1.75, [-8, 0]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b3\", \"sketch\": \"$sketch\", \"end\": \"blind\", \"depth\": \"=leadnut_flange_t\"})\n    .sketch('front', (s) => { s.circle(1.75, [0, -8]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b4\", \"sketch\": \"$sketch\", \"end\": \"blind\", \"depth\": \"=leadnut_flange_t\"})\n    .sketch('front', (s) => { s.circle(1.75, [8, 0]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b5\", \"sketch\": \"$sketch\", \"end\": \"blind\", \"depth\": \"=leadnut_flange_t\"})\n    .sketch('front', (s) => { s.circle(1.75, [0, 8]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b6\", \"sketch\": \"$sketch\", \"end\": \"blind\", \"depth\": \"=leadnut_flange_t\"})\n    .combine('union', \"b3\", [\"b4\", \"b5\", \"b6\"])\n    .combine('cut', \"b2\", [\"b3\", \"b4\", \"b5\", \"b6\"])\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b2\"}], \"translate\": [0.0, 0.0, \"=leadnut_flange_offset\"]})\n    .combine('union', \"b1\", [\"b2\"])\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b1\"}], \"translate\": [0.0, 0.0, \"=((-leadnut_flange_offset)-leadnut_flange_t)\"]})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b1\"}], \"rotate\": {\"axis\": \"x\", \"origin\": [0, 0, 0], \"angle\": 180.0}})\n    .appearance({ feature: 'F2', colour: '#696969' })\n    .appearance({ feature: 'F4', colour: '#696969' })\n    .appearance({ feature: 'F6', colour: '#696969' })\n    .appearance({ feature: 'F8', colour: '#696969' })\n    .appearance({ feature: 'F10', colour: '#696969' })\n    .appearance({ feature: 'F12', colour: '#696969' });\n});\n","appearance":{"F2":{"color":"#696969"},"F4":{"color":"#696969"},"F6":{"color":"#696969"},"F8":{"color":"#696969"},"F10":{"color":"#696969"},"F12":{"color":"#696969"}},"license":"GPL-3.0-or-later","source":"https://github.com/nophead/NopSCADlib/blob/00ec289/vitamins/leadnut.scad"}