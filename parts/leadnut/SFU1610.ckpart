"body\": \"b10\", \"sketch\": \"$sketch\", \"end\": \"blind\", \"depth\": \"=leadnut_flange_t\"})\n    .combine('union', \"b9\", [\"b10\"])\n    .combine('cut', \"b2\", [\"b3\", \"b4\", \"b5\", \"b6\", \"b7\", \"b8\", \"b9\", \"b10\"])\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b2\"}], \"translate\": [0.0, 0.0, \"=leadnut_flange_offset\"]})\n    .combine('union', \"b1\", [\"b2\"])\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b1\"}], \"translate\": [0.0, 0.0, \"=((-leadnut_flange_offset)-leadnut_flange_t)\"]})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b1\"}], \"rotate\": {\"axis\": \"x\", \"origin\": [0, 0, 0], \"angle\": 180.0}})\n    .appearance({ feature: 'F2', colour: '#dfdac5' })\n    .appearance({ feature: 'F4', colour: '#dfdac5' })\n    .appearance({ feature: 'F6', colour: '#dfdac5' })\n    .appearance({ feature: 'F8', colour: '#dfdac5' })\n    .appearance({ feature: 'F10', colour: '#dfdac5' })\n    .appearance({ feature: 'F12', colour: '#dfdac5' })\n    .appearance({ feature: 'F14', colour: '#dfdac5' })\n    .appearance({ feature: 'F16', colour: '#dfdac5' })\n    .appearance({ feature: 'F19', colour: '#dfdac5' })\n    .appearance({ feature: 'F21', colour: '#dfdac5' });\n});\n","appearance":{"F2":{"color":"#dfdac5"},"F4":{"color":"#dfdac5"},"F6":{"color":"#dfdac5"},"F8":{"color":"#dfdac5"},"F10":{"color":"#dfdac5"},"F12":{"color":"#dfdac5"},"F14":{"color":"#dfdac5"},"F16":{"color":"#dfdac5"},"F19":{"color":"#dfdac5"},"F21":{"color":"#dfdac5"}},"license":"GPL-3.0-or-later","source":"https://github.com/nophead/NopSCADlib/blob/00ec289/vitamins/leadnut.scad"}