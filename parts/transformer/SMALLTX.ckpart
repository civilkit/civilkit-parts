"},"tools":[{"body":"b4"},{"body":"b5"}],"id":"F15","group":"SMALLTX"}],"seq":16,"rollback":null,"variables":[{"name":"tx_bobbin_height","expr":"20"},{"name":"tx_bobbin_offset","expr":"0"},{"name":"tx_foot_thickness","expr":"0.8"},{"name":"tx_lamination_height","expr":"33"}],"script":"// transformer(SMALLTX) from NopSCADlib 00ec289 (GPL-3.0-or-later); see ../NOTICE.md\n// Generated by openscad_to_ckpart.py. Edit freely: running this script rebuilds the feature history.\nvariables({ tx_bobbin_height: 20, tx_bobbin_offset: 0, tx_foot_thickness: 0.8, tx_lamination_height: 33 });\nconst p = part(\"SMALLTX\");\ngroup(\"SMALLTX\", () => {\n  p\n    .sketchFeature('front', {\"points\": [{\"id\": \"O\", \"x\": 0, \"y\": 0, \"fixed\": true}, {\"id\": \"p1\", \"x\": -27.0, \"y\": -6.0}, {\"id\": \"p14\", \"x\": -29.0, \"y\": -4.0}, {\"id\": \"p15\", \"x\": -29.0, \"y\": 4.0}, {\"id\": \"p28\", \"x\": -27.0, \"y\": 6.0}, {\"id\": \"p29\", \"x\": 27.0, \"y\": 6.0}, {\"id\": \"p42\", \"x\": 29.0, \"y\": 4.0}, {\"id\": \"p43\", \"x\": 29.0, \"y\": -4.0}, {\"id\": \"p56\", \"x\": 27.0, \"y\": -6.0}, {\"id\": \"p57\", \"x\": -27.0, \"y\": -4.0}, {\"id\": \"p58\", \"x\": -27.0, \"y\": 4.0}, {\"id\": \"p59\", \"x\": 27.0, \"y\": 4.0}, {\"id\": \"p60\", \"x\": 27.0, \"y\": -4.0}], \"entities\": [{\"id\": \"e1\", \"type\": \"arc\", \"c\": \"p57\", \"p1\": \"p14\", \"p2\": \"p1\"}, {\"id\": \"e2\", \"type\": \"line\", \"p1\": \"p14\", \"p2\": \"p15\"}, {\"id\": \"e3\", \"type\": \"arc\", \"c\": \"p58\", \"p1\": \"p28\", \"p2\": \"p15\"}, {\"id\": \"e4\", \"type\": \"line\", \"p1\": \"p28\", \"p2\": \"p29\"}, {\"id\": \"e5\", \"type\": \"arc\", \"c\": \"p59\", \"p1\": \"p42\", \"p2\": \"p29\"}, {\"id\": \"e6\", \"type\": \"line\", \"p1\": \"p42\", \"p2\": \"p43\"}, {\"id\": \"e7\", \"type\": \"arc\", \"c\": \"p60\", \"p1\": \"p56\", \"p2\": \"p43\"}, {\"id\": \"e8\", \"type\": \"line\", \"p1\": \"p56\", \"p2\": \"p1\"}]})\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b1\", \"sketch\": \"$sketch\", \"end\": \"blind\", \"depth\": \"=tx_foot_thickness\"})\n    .sketch('front', (s) => { s.circle(1, [-23.5, 0]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b2\", \"sketch\": \"$sketch\", \"end\": \"blind\", \"depth\": \"=tx_foot_thickness\"})\n    .sketch('front', (s) => { s.circle(1, [23.5, 0]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b3\", \"sketch\": \"$sketch\", \"end\": \"blind\", \"depth\": \"=tx_foot_thickness\"})\n    .combine('union', \"b2\", [\"b3\"])\n    .combine('cut', \"b1\", [\"b2\", \"b3\"])\n    .sketch('front', (s) => { s.polygon([[-19, -8], [19, -8], [19, 8], [-19, 8]]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b4\", \"sketch\": \"$sketch\", \"end\": \"mid\", \"depth\": \"=tx_lamination_height\"})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b4\"}], \"translate\": [0.0, 0.0, \"=(tx_lamination_height/2)\"]})\n    .sketchFeature('front', {\"points\": [{\"id\": \"O\", \"x\": 0, \"y\": 0, \"fixed\": true}, {\"id\": \"p1\", \"x\": -10.5, \"y\": -16.0}, {\"id\": \"p14\", \"x\": -12.5, \"y\": -14.0}, {\"id\": \"p15\", \"x\": -12.5, \"y\": 14.0}, {\"id\": \"p28\", \"x\": -10.5, \"y\": 16.0}, {\"id\": \"p29\", \"x\": 10.5, \"y\": 16.0}, {\"id\": \"p42\", \"x\": 12.5, \"y\": 14.0}, {\"id\": \"p43\", \"x\": 12.5, \"y\": -14.0}, {\"id\": \"p56\", \"x\": 10.5, \"y\": -16.0}, {\"id\": \"p57\", \"x\": -10.5, \"y\": -14.0}, {\"id\": \"p58\", \"x\": -10.5, \"y\": 14.0}, {\"id\": \"p59\", \"x\": 10.5, \"y\": 14.0}, {\"id\": \"p60\", \"x\": 10.5, \"y\": -14.0}], \"entities\": [{\"id\": \"e1\", \"type\": \"arc\", \"c\": \"p57\", \"p1\": \"p14\", \"p2\": \"p1\"}, {\"id\": \"e2\", \"type\": \"line\", \"p1\": \"p14\", \"p2\": \"p15\"}, {\"id\": \"e3\", \"type\": \"arc\", \"c\": \"p58\", \"p1\": \"p28\", \"p2\": \"p15\"}, {\"id\": \"e4\", \"type\": \"line\", \"p1\": \"p28\", \"p2\": \"p29\"}, {\"id\": \"e5\", \"type\": \"arc\", \"c\": \"p59\", \"p1\": \"p42\", \"p2\": \"p29\"}, {\"id\": \"e6\", \"type\": \"line\", \"p1\": \"p42\", \"p2\": \"p43\"}, {\"id\": \"e7\", \"type\": \"arc\", \"c\": \"p60\", \"p1\": \"p56\", \"p2\": \"p43\"}, {\"id\": \"e8\", \"type\": \"line\", \"p1\": \"p56\", \"p2\": \"p1\"}]})\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b5\", \"sketch\": \"$sketch\", \"end\": \"mid\", \"depth\": \"=tx_bobbin_height\"})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b5\"}], \"translate\": [0.0, 0.0, \"=((tx_lamination_height/2)+(tx_bobbin_offset/2))\"]})\n    .combine('union', \"b1\", [\"b4\", \"b5\"])\n    .appearance({ feature: 'F2', colour: '#c0c0c0' })\n    .appearance({ feature: 'F4', colour: '#c0c0c0' })\n    .appearance({ feature: 'F6', colour: '#c0c0c0' })\n    .appearance({ feature: 'F10', colour: '#c0c0c0' })\n    .appearance({ feature: 'F13', colour: '#ffffff' });\n});\n","appearance":{"F2":{"color":"#c0c0c0"},"F4":{"color":"#c0c0c0"},"F6":{"color":"#c0c0c0"},"F10":{"color":"#c0c0c0"},"F13":{"color":"#ffffff"}},"license":"GPL-3.0-or-later","source":"https://github.com/nophead/NopSCADlib/blob/00ec289/vitamins/transformer.scad"}