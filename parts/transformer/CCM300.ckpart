"extrude\", \"op\": \"newBody\", \"body\": \"b6\", \"sketch\": \"$sketch\", \"end\": \"mid\", \"depth\": \"=tx_lamination_height\"})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b6\"}], \"translate\": [0.0, 0.0, \"=(tx_lamination_height/2)\"]})\n    .sketchFeature('front', {\"points\": [{\"id\": \"O\", \"x\": 0, \"y\": 0, \"fixed\": true}, {\"id\": \"p1\", \"x\": -31.5, \"y\": -44.0}, {\"id\": \"p16\", \"x\": -39.5, \"y\": -36.0}, {\"id\": \"p17\", \"x\": -39.5, \"y\": 36.0}, {\"id\": \"p32\", \"x\": -31.5, \"y\": 44.0}, {\"id\": \"p33\", \"x\": 31.5, \"y\": 44.0}, {\"id\": \"p48\", \"x\": 39.5, \"y\": 36.0}, {\"id\": \"p49\", \"x\": 39.5, \"y\": -36.0}, {\"id\": \"p64\", \"x\": 31.5, \"y\": -44.0}, {\"id\": \"p65\", \"x\": -31.5, \"y\": -36.0}, {\"id\": \"p66\", \"x\": -31.5, \"y\": 36.0}, {\"id\": \"p67\", \"x\": 31.5, \"y\": 36.0}, {\"id\": \"p68\", \"x\": 31.5, \"y\": -36.0}], \"entities\": [{\"id\": \"e1\", \"type\": \"arc\", \"c\": \"p65\", \"p1\": \"p16\", \"p2\": \"p1\"}, {\"id\": \"e2\", \"type\": \"line\", \"p1\": \"p16\", \"p2\": \"p17\"}, {\"id\": \"e3\", \"type\": \"arc\", \"c\": \"p66\", \"p1\": \"p32\", \"p2\": \"p17\"}, {\"id\": \"e4\", \"type\": \"line\", \"p1\": \"p32\", \"p2\": \"p33\"}, {\"id\": \"e5\", \"type\": \"arc\", \"c\": \"p67\", \"p1\": \"p48\", \"p2\": \"p33\"}, {\"id\": \"e6\", \"type\": \"line\", \"p1\": \"p48\", \"p2\": \"p49\"}, {\"id\": \"e7\", \"type\": \"arc\", \"c\": \"p68\", \"p1\": \"p64\", \"p2\": \"p49\"}, {\"id\": \"e8\", \"type\": \"line\", \"p1\": \"p64\", \"p2\": \"p1\"}]})\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b7\", \"sketch\": \"$sketch\", \"end\": \"mid\", \"depth\": \"=tx_bobbin_height\"})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b7\"}], \"translate\": [0.0, 0.0, \"=((tx_lamination_height/2)+(tx_bobbin_offset/2))\"]})\n    .combine('union', \"b1\", [\"b6\", \"b7\"])\n    .appearance({ feature: 'F2', colour: '#c0c0c0' })\n    .appearance({ fe