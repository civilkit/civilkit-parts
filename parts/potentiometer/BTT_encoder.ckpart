ints":[],"group":"BTT_encoder"},{"type":"extrude","op":"newBody","body":"b3","sketch":"F7","end":"blind","depth":0.5,"id":"F8","group":"BTT_encoder"},{"type":"sketch","id":"F9","plane":{"kind":"std","id":"front"},"points":[{"id":"O","x":0,"y":0,"fixed":true},{"id":"p1","x":0,"y":0}],"entities":[{"id":"e1","type":"circle","c":"p1","r":2.5}],"constraints":[],"group":"BTT_encoder"},{"type":"extrude","op":"newBody","body":"b4","sketch":"F9","end":"blind","depth":9,"id":"F10","group":"BTT_encoder"},{"type":"sketch","id":"F11","plane":{"kind":"std","id":"front"},"points":[{"id":"O","x":0,"y":0,"fixed":true},{"id":"p1","x":-0.375,"y":-3},{"id":"p2","x":0.375,"y":-3},{"id":"p3","x":0.375,"y":3},{"id":"p4","x":-0.375,"y":3}],"entities":[{"id":"e1","type":"line","p1":"p1","p2":"p2"},{"id":"e2","type":"line","p1":"p2","p2":"p3"},{"id":"e3","type":"line","p1":"p3","p2":"p4"},{"id":"e4","type":"line","p1":"p4","p2":"p1"}],"constraints":[],"group":"BTT_encoder"},{"type":"extrude","op":"newBody","body":"b5","sketch":"F11","end":"blind","depth":9,"id":"F12","group":"BTT_encoder"},{"type":"combine","op":"cut","target":{"body":"b4"},"tools":[{"body":"b5"}],"id":"F13","group":"BTT_encoder"},{"type":"moveBody","bodies":[{"body":"b4"}],"translate":[0,0,0.5],"id":"F14","group":"BTT_encoder"},{"type":"combine","op":"union","target":{"body":"b3"},"tools":[{"body":"b4"}],"id":"F15","group":"BTT_encoder"},{"type":"moveBody","bodies":[{"body":"b3"},{"body":"b4"}],"rotate":{"axis":"x","origin":[0,0,0],"angle":180},"id":"F16","group":"BTT_encoder"},{"type":"moveBody","bodies":[{"body":"b3"},{"body":"b4"}],"translate":[0,0,"=(-pot_thread_h)"],"id":"F17","group":"BTT_encoder"},{"type":"combine","op":"union","target":{"body":"b1"},"tools":[{"body":"b2"},{"body":"b3"},{"body":"b4"}],"id":"F18","group":"BTT_encoder"}],"seq":19,"rollback":null,"variables":[{"name":"pot_boss_h","expr":"0"},{"name":"pot_gangs","expr":"1"},{"name":"pot_thread_h","expr":"4.5"}],"script":"// potentiometer(BTT_encoder) from NopSCADlib 00ec289 (GPL-3.0-or-later); see ../NOTICE.md\n// Generated by openscad_to_ckpart.py. Edit freely: running this script rebuilds the feature history.\nvariables({ pot_boss_h: 0, pot_gangs: 1, pot_thread_h: 4.5 });\nconst p = part(\"BTT_encoder\");\ngroup(\"BTT_encoder\", () => {\n  p\n    .sketch('front', (s) => { s.circle(3, [0, 0]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b1\", \"sketch\": \"$sketch\", \"end\": \"blind\", \"depth\": \"=pot_thread_h\"})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b1\"}], \"rotate\": {\"axis\": \"x\", \"origin\": [0, 0, 0], \"angle\": 180.0}})\n    .sketchFeature('front', {\"points\": [{\"id\": \"O\", \"x\": 0, \"y\": 0, \"fixed\": true}, {\"id\": \"p1\", \"x\": -5.5, \"y\": -5.5}, {\"id\": \"p9\", \"x\": -6.0, \"y\": -5.0}, {\"id\": \"p10\", \"x\": -6.0, \"y\": 5.0}, {\"id\": \"p18\", \"x\": -5.5, \"y\": 5.5}, {\"id\": \"p19\", \"x\": 5.5, \"y\": 5.5}, {\"id\": \"p27\", \"x\": 6.0, \"y\": 5.0}, {\"id\": \"p28\", \"x\": 6.0, \"y\": -5.0}, {\"id\": \"p36\", \"x\": 5.5, \"y\": -5.5}, {\"id\": \"p37\", \"x\": -5.5, \"y\": -5.0}, {\"id\": \"p38\", \"x\": -5.5, \"y\": 5.0}, {\"id\": \"p39\", \"x\": 5.5, \"y\": 5.0}, {\"id\": \"p40\", \"x\": 5.5, \"y\": -5.0}], \"entities\": [{\"id\": \"e1\", \"type\": \"arc\", \"c\": \"p37\", \"p1\": \"p9\", \"p2\": \"p1\"}, {\"id\": \"e2\", \"type\": \"line\", \"p1\": \"p9\", \"p2\": \"p10\"}, {\"id\": \"e3\", \"type\": \"arc\", \"c\": \"p38\", \"p1\": \"p18\", \"p2\": \"p10\"}, {\"id\": \"e4\", \"type\": \"line\", \"p1\": \"p18\", \"p2\": \"p19\"}, {\"id\": \"e5\", \"type\": \"arc\", \"c\": \"p39\", \"p1\": \"p27\", \"p2\": \"p19\"}, {\"id\": \"e6\", \"type\": \"line\", \"p1\": \"p27\", \"p2\": \"p28\"}, {\"id\": \"e7\", \"type\": \"arc\", \"c\": \"p40\", \"p1\": \"p36\", \"p2\": \"p28\"}, {\"id\": \"e8\", \"type\": \"line\", \"p1\": \"p36\", \"p2\": \"p1\"}]})\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b2\", \"sketch\": \"$sketch\", \"end\": \"blind\", \"depth\": \"=((((6-pot_boss_h)-((pot_gangs-1)*0))/pot_gangs)-0)\"})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b2\"}], \"translate\": [0.0, 0.0, \"=(pot_boss_h+(0*((((6-pot_boss_h)-((pot_gangs-1)*0))/pot_gangs)+0)))\"]})\n    .sketch('front', (s) => { s.circle(1.5, [0, 0]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b3\", \"sketch\": \"$sketch\", \"end\": \"blind\", \"depth\": 0.5})\n    .sketch('front', (s) => { s.circle(2.5, [0, 0]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b4\", \"sketch\": \"$sketch\", \"end\": \"blind\", \"depth\": 9.0})\n    .sketch('front', (s) => { s.polygon([[-0.375, -3], [0.375, -3], [0.375, 3], [-0.375, 3]]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b5\", \"sketch\": \"$sketch\", \"end\": \"blind\", \"depth\": 9.0})\n    .combine('cut', \"b4\", [\"b5\"])\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b4\"}], \"translate\": [0.0, 0.0, 0.5]})\n    .combine('union', \"b3\", [\"b4\"])\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b3\"}, {\"body\": \"b4\"}], \"rotate\": {\"axis\": \"x\", \"origin\": [0, 0, 0], \"angle\": 180.0}})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b3\"}, {\"body\": \"b4\"}], \"translate\": [0.0, 0.0, \"=(-pot_thread_h)\"]})\n    .combine('union', \"b1\", [\"b2\", \"b3\", \"b4\"])\n    .appearance({ feature: 'F2', colour: '#999999' })\n    .appearance({ feature: 'F5', colour: '#bfbfbf' })\n    .appearance({ feature: 'F8', colour: '#bfbfbf' })\n    .appearance({ feature: 'F10', colour: '#bfbfbf' })\n    .appearance({ feature: 'F12', colour: '#bfbfbf' });\n});\n","appearance":{"F2":{"color":"#999999"},"F5":{"color":"#bfbfbf"},"F8":{"color":"#bfbfbf"},"F10":{"color":"#bfbfbf"},"F12":{"color":"#bfbfbf"}},"license":"GPL-3.0-or-later","source":"https://github.com/nophead/NopSCADlib/blob/00ec289/vitamins/po