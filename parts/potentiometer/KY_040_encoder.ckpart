2":"p10"},{"id":"e4","type":"line","p1":"p18","p2":"p19"},{"id":"e5","type":"arc","c":"p39","p1":"p27","p2":"p19"},{"id":"e6","type":"line","p1":"p27","p2":"p28"},{"id":"e7","type":"arc","c":"p40","p1":"p36","p2":"p28"},{"id":"e8","type":"line","p1":"p36","p2":"p1"}],"constraints":[],"group":"KY_040_encoder"},{"type":"extrude","op":"newBody","body":"b3","sketch":"F8","end":"blind","depth":"=((((6.5-pot_boss_h)-((pot_gangs-1)*0))/pot_gangs)-0)","id":"F9","group":"KY_040_encoder"},{"type":"moveBody","bodies":[{"body":"b3"}],"translate":[0,0,"=(pot_boss_h+(0*((((6.5-pot_boss_h)-((pot_gangs-1)*0))/pot_gangs)+0)))"],"id":"F10","group":"KY_040_encoder"},{"type":"sketch","id":"F11","plane":{"kind":"std","id":"front"},"points":[{"id":"O","x":0,"y":0,"fixed":true},{"id":"p1","x":0,"y":0}],"entities":[{"id":"e1","type":"circle","c":"p1","r":2}],"constraints":[],"group":"KY_040_encoder"},{"type":"extrude","op":"newBody","body":"b4","sketch":"F11","end":"blind","depth":0.5,"id":"F12","group":"KY_040_encoder"},{"type":"sketch","id":"F13","plane":{"kind":"std","id":"front"},"points":[{"id":"O","x":0,"y":0,"fixed":true},{"id":"p1","x":0,"y":0}],"entities":[{"id":"e1","type":"circle","c":"p1","r":3}],"constraints":[],"group":"KY_040_encoder"},{"type":"extrude","op":"newBody","body":"b5","sketch":"F13","end":"blind","depth":2.5,"id":"F14","group":"KY_040_encoder"},{"type":"moveBody","bodies":[{"body":"b5"}],"translate":[0,0,0.5],"id":"F15","group":"KY_040_encoder"},{"type":"sketch","id":"F16","plane":{"kind":"std","id":"front"},"points":[{"id":"O","x":0,"y":0,"fixed":true},{"id":"p1","x":0,"y":0}],"entities":[{"id":"e1","type":"circle","c":"p1","r":3}],"constraints":[],"group":"KY_040_encoder"},{"type":"extrude","op":"newBody","body":"b6","sketch":"F16","end":"blind","depth":10,"id":"F17","group":"KY_040_encoder"},{"type":"sketch","id":"F18","plane":{"kind":"std","id":"front"},"points":[{"id":"O","x":0,"y":0,"fixed":true},{"id":"p1","x":-3,"y":1.5},{"id":"p2","x":3,"y":1.5},{"id":"p3","x":3,"y":4.5},{"id":"p4","x":-3,"y":4.5}],"entities":[{"id":"e1","type":"line","p1":"p1","p2":"p2"},{"id":"e2","type":"line","p1":"p2","p2":"p3"},{"id":"e3","type":"line","p1":"p3","p2":"p4"},{"id":"e4","type":"line","p1":"p4","p2":"p1"}],"constraints":[],"group":"KY_040_encoder"},{"type":"extrude","op":"newBody","body":"b7","sketch":"F18","end":"blind","depth":10,"id":"F19","group":"KY_040_encoder"},{"type":"combine","op":"cut","target":{"body":"b6"},"tools":[{"body":"b7"}],"id":"F20","group":"KY_040_encoder"},{"type":"moveBody","bodies":[{"body":"b6"}],"translate":[0,0,3],"id":"F21","group":"KY_040_encoder"},{"type":"combine","op":"union","target":{"body":"b4"},"tools":[{"body":"b5"},{"body":"b6"}],"id":"F22","group":"KY_040_encoder"},{"type":"moveBody","bodies":[{"body":"b4"}],"rotate":{"axis":"x","origin":[0,0,0],"angle":180},"id":"F23","group":"KY_040_encoder"},{"type":"moveBody","bodies":[{"body":"b4"}],"translate":[0,0,"=(-pot_thread_h)"],"id":"F24","group":"KY_040_encoder"},{"type":"combine","op":"union","target":{"body":"b1"},"tools":[{"body":"b2"},{"body":"b3"},{"body":"b4"}],"id":"F25","group":"KY_040_encoder"}],"seq":26,"rollback":null,"variables":[{"name":"pot_boss_h","expr":"0"},{"name":"pot_gangs","expr":"1"},{"name":"pot_spigot_x","expr":"5.8"},{"name":"pot_thread_h","expr":"7"}],"script":"// potentiometer(KY_040_encoder) from NopSCADlib 00ec289 (GPL-3.0-or-later); see ../NOTICE.md\n// Generated by openscad_to_ckpart.py. Edit freely: running this script rebuilds the feature history.\nvariables({ pot_boss_h: 0, pot_gangs: 1, pot_spigot_x: 5.8, pot_thread_h: 7 });\nconst p = part(\"KY_040_encoder\");\ngroup(\"KY_040_encoder\", () => {\n  p\n    .sketch('front', (s) => { s.polygon([[-0.2, -1], [-0.2, 1], [0.2, 1], [0.2, -1]]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b1\", \"sketch\": \"$sketch\", \"end\": \"blind\", \"depth\": \"=(0.8+pot_boss_h)\"})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b1\"}], \"rotate\": {\"axis\": \"x\", \"origin\": [0, 0, 0], \"angle\": 180.0}})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b1\"}], \"translate\": [\"=pot_spigot_x\", 0.0, \"=pot_boss_h\"]})\n    .sketch('front', (s) => { s.circle(3.5, [0, 0]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b2\", \"sketch\": \"$sketch\", \"end\": \"blind\", \"depth\": \"=pot_thread_h\"})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b2\"}], \"rotate\": {\"axis\": \"x\", \"origin\": [0, 0, 0], \"angle\": 180.0}})\n    .sketchFeature('front', {\"points\": [{\"id\": \"O\", \"x\": 0, \"y\": 0, \"fixed\": true}, {\"id\": \"p1\", \"x\": -5.0, \"y\": -6.0}, {\"id\": \"p9\", \"x\": -6.0, \"y\": -5.0}, {\"id\": \"p10\", \"x\": -6.0, \"y\": 5.0}, {\"id\": \"p18\", \"x\": -5.0, \"y\": 6.0}, {\"id\": \"p19\", \"x\": 5.0, \"y\": 6.0}, {\"id\": \"p27\", \"x\": 6.0, \"y\": 5.0}, {\"id\": \"p28\", \"x\": 6.0, \"y\": -5.0}, {\"id\": \"p36\", \"x\": 5.0, \"y\": -6.0}, {\"id\": \"p37\", \"x\": -5.0, \"y\": -5.0}, {\"id\": \"p38\", \"x\": -5.0, \"y\": 5.0}, {\"id\": \"p39\", \"x\": 5.0, \"y\": 5.0}, {\"id\": \"p40\", \"x\": 5.0, \"y\": -5.0}], \"entities\": [{\"id\": \"e1\", \"type\": \"arc\", \"c\": \"p37\", \"p1\": \"p9\", \"p2\": \"p1\"}, {\"id\": \"e2\", \"type\": \"line\", \"p1\": \"p9\", \"p2\": \"p10\"}, {\"id\": \"e3\", \"type\": \"arc\", \"c\": \"p38\", \"p1\": \"p18\", \"p2\": \"p10\"}, {\"id\": \"e4\", \"type\": \"line\", \"p1\": \"p18\", \"p2\": \"p19\"}, {\"id\": \"e5\", \"type\": \"arc\", \"c\": \"p39\", \"p1\": \"p27\", \"p2\": \"p19\"}, {\"id\": \"e6\", \"type\": \"line\", \"p1\": \"p27\", \"p2\": \"p28\"}, {\"id\": \"e7\", \"type\": \"arc\", \"c\": \"p40\", \"p1\": \"p36\", \"p2\": \"p28\"}, {\"id\": \"e8\", \"type\": \"line\", \"p1\": \"p36\", \"p2\": \"p1\"}]})\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b3\", \"sketch\": \"$sketch\", \"end\": \"blind\", \"depth\": \"=((((6.5-pot_boss_h)-((pot_gangs-1)*0))/pot_gangs)-0)\"})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b3\"}], \"translate\": [0.0, 0.0, \"=(pot_boss_h+(0*((((6.5-pot_boss_h)-((pot_gangs-1)*0))/pot_gangs)+0)))\"]})\n    .sketch('front', (s) => { s.circle(2, [0, 0]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b4\", \"sketch\": \"$sketch\", \"end\": \"blind\", \"depth\": 0.5})\n    .sketch('front', (s) => { s.circle(3, [0, 0]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b5\", \"sketch\": \"$sketch\", \"end\": \"blind\", \"depth\": 2.5})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b5\"}], \"translate\": [0.0, 0.0, 0.5]})\n    .sketch('front', (s) => { s.circle(3, [0, 0]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b6\", \"sketch\": \"$sketch\", \"end\": \"blind\", \"depth\": 10.0})\n    .sketch('front', (s) => { s.polygon([[-3, 1.5], [3, 1.5], [3, 4.5], [-3, 4.5]]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b7\", \"sketch\": \"$sketch\", \"end\": \"blind\", \"depth\": 10.0})\n    .combine('cut', \"b6\", [\"b7\"])\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b6\"}], \"translate\": [0.0, 0.0, 3.0]})\n    .combine('union', \"b4\", [\"b5\", \"b6\"])\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b4\"}], \"rotate\": {\"axis\": \"x\", \"origin\": [0, 0, 0], \"angle\": 180.0}})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b4\"}], \"translate\": [0.0, 0.0, \"=(-pot_thread_h)\"]})\n    .combine('union', \"b1\", [\"b2\", \"b3\", \"b4\"])\n    .appearance({ feature: 'F2', colour: '#999999' })\n    .appearance({ feature: 'F6', colour: '#999999' })\n    .appearance({ feature: 'F9', colour: '#bfbfbf' })\n    .appearance({ feature: 'F12', colour: '#999999' })\n    .appearance({ feature: 'F14', colour: '#999999' })\n    .appearance({ feature: 'F17', colour: '#999999' })\n    .appearance({ feature: 'F19', colour: '#999999' });\n});\n","appearance":{"F2":{"color":"#999999"},"F6":{"color":"#999999"},"F9":{"color":"#bfbfbf"},"F12":{"color":"#999999"},"F14":{"color":"#999999"},"F17":{"color":"#999999"},"F19":{"color":"#999999"}},"license":"GPL-3.0-or-later","source":"https://github.com/nophead/NopSCADlib/blob/00ec289/vitamins/potentiometer.scad"}