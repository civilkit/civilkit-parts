{"format":"ck-part","version":1,"name":"M2x16_brass_pillar","features":[{"type":"sketch","id":"F1","plane":{"kind":"std","id":"front"},"points":[{"id":"O","x":0,"y":0,"fixed":true},{"id":"p1","x":0,"y":0}],"entities":[{"id":"e1","type":"circle","c":"p1","r":1}],"constraints":[],"group":"M2x16_brass_pillar"},{"type":"extrude","op":"newBody","body":"b1","sketch":"F1","end":"blind","depth":"=pillar_top_thread","id":"F2","group":"M2x16_brass_pillar"},{"type":"moveBody","bodies":[{"body":"b1"}],"translate":[0,0,"=(pillar_height-0.0078125)"],"id":"F3","group":"M2x16_brass_pillar"},{"type":"sketch","id":"F4","plane":{"kind":"std","id":"front"},"points":[{"id":"O","x":0,"y":0,"fixed":true},{"id":"p1","x":0,"y":0},{"id":"p2","x":0,"y":0}],"entities":[{"id":"e1","type":"circle","c":"p1","r":1.585},{"id":"e2","type":"circle","c":"p2","r":1}],"constraints":[],"group":"M2x16_brass_pillar"},{"type":"extrude","op":"newBody","body":"b2","sketch":"F4","end":"blind","depth":"=pillar_height","id":"F5","group":"M2x16_brass_pillar"},{"type":"sketch","id":"F6","plane":{"kind":"std","id":"front"},"points":[{"id":"O","x":0,"y":0,"fixed":true},{"id":"p1","x":0,"y":0}],"entities":[{"id":"e1","type":"circle","c":"p1","r":1.00391}],"constraints":[],"group":"M2x16_brass_pillar"},{"type":"extrude","op":"newBody","body":"b3","sketch":"F6","end":"blind","depth":"=((pillar_height+0)-(-pillar_bot_thread))","id":"F7","group":"M2x16_brass_pillar"},{"type":"moveBody","bodies":[{"body":"b3"}],"translate":[0,0,"=(-pillar_bot_thread)"],"id":"F8","group":"M2x16_brass_pillar"},{"type":"combine","op":"union","target":{"body":"b1"},"tools":[{"body":"b2"},{"body":"b3"}],"id":"F9","group":"M2x16_brass_pillar"}],"seq":10,"rollback":null,"variables":[{"name":"pillar_bot_thread","expr":"-3"},{"name":"pillar_height","expr":"16"},{"name":"pillar_top_thread","expr":"3"}],"script":"// pillar(M2x16_brass_pillar) from NopSCADlib 00ec289 (GPL-3.0-or-later); see ../NOTICE.md\n// Generated by openscad_to_ckpart.py. Edit freely: running this script rebuilds the feature history.\nvariables({ pillar_bot_thread: -3, pillar_height: 16, pillar_top_thread: 3 });\nconst p = part(\"M2x16_brass_pillar\");\ngroup(\"M2x16_brass_pillar\", () => {\n  p\n    .sketch('front', (s) => { s.circle(1, [0, 0]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b1\", \"sketch\": \"$sketch\", \"end\": \"blind\", \"depth\": \"=pillar_top_thread\"})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b1\"}], \"translate\": [0.0, 0.0, \"=(pillar_height-0.0078125)\"]})\n    .sketch('front', (s) => { s.circle(1.585, [0, 0]); s.circle(1, [0, 0]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b2\", \"sketch\": \"$sketch\", \"end\": \"blind\", \"depth\": \"=pillar_height\"})\n    .sketch('front', (s) => { s.circle(1.00391, [0, 0]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b3\", \"sketch\": \"$sketch\", \"end\": \"blind\", \"depth\": \"=((pillar_height+0)-(-pillar_bot_thread))\"})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b3\"}], \"translate\": [0.0, 0.0, \"=(-pillar_bot_thread)\"]})\n    .combine('union', \"b1\", [\"b2\", \"b3\"])\n    .appearance({ feature: 'F2', colour: '#ffdc64' })\n    .appearance({ feature: 'F5', colour: '#ffdc64' })\n    .appearance({ feature: 'F7', colour: '#ffdc64' });\n});\n","appearance":{"F2":{"color":"#ffdc64"},"F5":{"color":"#ffdc64"},"F7":{"color":"#ffdc64"}},"license":"GPL-3.0-or-later","source":"https://github.com/nophead/NopSCADlib/blob/00ec289/vitamins/pillar.scad"}