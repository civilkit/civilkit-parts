{"format":"ck-part","version":1,"name":"M3_rubber_washer","features":[{"type":"sketch","id":"F1","plane":{"kind":"std","id":"front"},"points":[{"id":"O","x":0,"y":0,"fixed":true},{"id":"p1","x":0,"y":0},{"id":"p2","x":0,"y":0}],"entities":[{"id":"e1","type":"circle","c":"p1","r":5},{"id":"e2","type":"circle","c":"p2","r":1.55}],"constraints":[],"group":"M3_rubber_washer"},{"type":"extrude","op":"newBody","body":"b1","sketch":"F1","end":"blind","depth":"=(washer_thickness-0.05)","id":"F2","group":"M3_rubber_washer"}],"seq":3,"rollback":null,"variables":[{"name":"washer_thickness","expr":"1.5"}],"script":"// washer(M3_rubber_washer) from NopSCADlib 00ec289 (GPL-3.0-or-later); see ../NOTICE.md\n// Generated by openscad_to_ckpart.py. Edit freely: running this script rebuilds the feature history.\nvariables({ washer_thickness: 1.5 });\nconst p = part(\"M3_rubber_washer\");\ngroup(\"M3_rubber_washer\", () => {\n  p\n    .sketch('front', (s) => { s.circle(5, [0, 0]); s.circle(1.55, [0, 0]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b1\", \"sketch\": \"$sketch\", \"end\": \"blind\", \"depth\": \"=(washer_thickness-0.05)\"})\n    .appearance({ feature: 'F2', colour: '#333333' });\n});\n","appearance":{"F2":{"color":"#333333"}},"license":"GPL-3.0-or-later","source":"https://github.com/nophead/NopSCADlib/blob/00ec289/vitamins/washer.scad"}