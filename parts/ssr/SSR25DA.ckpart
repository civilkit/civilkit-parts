x\": -47.0, \"y\": 0.0}, {\"id\": \"p76\", \"x\": -23.5, \"y\": 0.0}, {\"id\": \"p77\", \"x\": -47.0, \"y\": 0.0}], \"entities\": [{\"id\": \"e1\", \"type\": \"arc\", \"c\": \"p75\", \"p1\": \"p1\", \"p2\": \"p19\"}, {\"id\": \"e2\", \"type\": \"line\", \"p1\": \"p19\", \"p2\": \"p20\"}, {\"id\": \"e3\", \"type\": \"arc\", \"c\": \"p76\", \"p1\": \"p20\", \"p2\": \"p56\"}, {\"id\": \"e4\", \"type\": \"line\", \"p1\": \"p56\", \"p2\": \"p57\"}, {\"id\": \"e5\", \"type\": \"arc\", \"c\": \"p77\", \"p1\": \"p57\", \"p2\": \"p1\"}]})\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b5\", \"sketch\": \"$sketch\", \"end\": \"blind\", \"depth\": \"=(ssr_height-ssr_base_t)\"})\n    .sketchFeature('front', {\"points\": [{\"id\": \"O\", \"x\": 0, \"y\": 0, \"fixed\": true}, {\"id\": \"p1\", \"x\": 18.5, \"y\": 0.0}, {\"id\": \"p19\", \"x\": 23.5, \"y\": -5.0}, {\"id\": \"p20\", \"x\": 47.0, \"y\": -5.0}, {\"id\": \"p56\", \"x\": 47.0, \"y\": 5.0}, {\"id\": \"p57\", \"x\": 23.5, \"y\": 5.0}, {\"id\": \"p75\", \"x\": 23.5, \"y\": 0.0}, {\"id\": \"p76\", \"x\": 47.0, \"y\": 0.0}, {\"id\": \"p77\", \"x\": 23.5, \"y\": 0.0}], \"entities\": [{\"id\": \"e1\", \"type\": \"arc\", \"c\": \"p75\", \"p1\": \"p1\", \"p2\": \"p19\"}, {\"id\": \"e2\", \"type\": \"line\", \"p1\": \"p19\", \"p2\": \"p20\"}, {\"id\": \"e3\", \"type\": \"arc\", \"c\": \"p76\", \"p1\": \"p20\", \"p2\": \"p56\"}, {\"id\": \"e4\", \"type\": \"line\", \"p1\": \"p56\", \"p2\": \"p57\"}, {\"id\": \"e5\", \"type\": \"arc\", \"c\": \"p77\", \"p1\": \"p57\", \"p2\": \"p1\"}]})\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b6\", \"sketch\": \"$sketch\", \"end\": \"blind\", \"depth\": \"=(ssr_height-ssr_base_t)\"})\n    .combine('union', \"b5\", [\"b6\"])\n    .combine('cut', \"b4\", [\"b5\", \"b6\"])\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b4\"}], \"translate\": [0.0, 0.0, \"=ssr_base_t\"]})\n    .combine('union', \"b1\", [\"b4\"])\n    .appearance({