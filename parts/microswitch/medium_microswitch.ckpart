:"2"},{"name":"microswitch_button_w","expr":"3.2"},{"name":"microswitch_thickness","expr":"6.4"}],"script":"// microswitch(medium_microswitch) from NopSCADlib 00ec289 (GPL-3.0-or-later); see ../NOTICE.md\n// Generated by openscad_to_ckpart.py. Edit freely: running this script rebuilds the feature history.\nvariables({ microswitch_button_t: 2, microswitch_button_w: 3.2, microswitch_thickness: 6.4 });\nconst p = part(\"medium_microswitch\");\ngroup(\"medium_microswitch\", () => {\n  p\n    .sketchFeature('front', {\"points\": [{\"id\": \"O\", \"x\": 0, \"y\": 0, \"fixed\": true}, {\"id\": \"p1\", \"x\": -8.9, \"y\": -5.1}, {\"id\": \"p9\", \"x\": -9.9, \"y\": -4.1}, {\"id\": \"p10\", \"x\": -9.9, \"y\": 4.1}, {\"id\": \"p18\", \"x\": -8.9, \"y\": 5.1}, {\"id\": \"p19\", \"x\": 8.9, \"y\": 5.1}, {\"id\": \"p27\", \"x\": 9.9, \"y\": 4.1}, {\"id\": \"p28\", \"x\": 9.9, \"y\": -4.1}, {\"id\": \"p36\", \"x\": 8.9, \"y\": -5.1}, {\"id\": \"p37\", \"x\": -8.9, \"y\": -4.1}, {\"id\": \"p38\", \"x\": -8.9, \"y\": 4.1}, {\"id\": \"p39\", \"x\": 8.9, \"y\": 4.1}, {\"id\": \"p40\", \"x\": 8.9, \"y\": -4.1}], \"entities\": [{\"id\": \"e1\", \"type\": \"arc\", \"c\": \"p37\", \"p1\": \"p9\", \"p2\": \"p1\"}, {\"id\": \"e2\", \"type\": \"line\", \"p1\": \"p9\", \"p2\": \"p10\"}, {\"id\": \"e3\", \"type\": \"arc\", \"c\": \"p38\", \"p1\": \"p18\", \"p2\": \"p10\"}, {\"id\": \"e4\", \"type\": \"line\", \"p1\": \"p18\", \"p2\": \"p19\"}, {\"id\": \"e5\", \"type\": \"arc\", \"c\": \"p39\", \"p1\": \"p27\", \"p2\": \"p19\"}, {\"id\": \"e6\", \"type\": \"line\", \"p1\": \"p27\", \"p2\": \"p28\"}, {\"id\": \"e7\", \"type\": \"arc\", \"c\": \"p40\", \"p1\": \"p36\", \"p2\": \"p28\"}, {\"id\": \"e8\", \"type\": \"line\", \"p1\": \"p36\", \"p2\": \"p1\"}]})\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b1\", \"sketch\": \"$sketch\", \"end\": \"mid\", \"depth\": \"=microswitch_thickness\"})\n    .sketch('front', (s) => { s.circle(1.175, [-4.8, -2.6]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b2\", \"sketch\": \"$sketch\", \"end\": \"mid\", \"depth\": \"=microswitch_thickness\"})\n    .sketch('front', (s) => { s.circle(1.175, [4.7, -2.6]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b3\", \"sketch\": \"$sketch\", \"end\": \"mid\", \"depth\": \"=microswitch_thickness\"})\n    .combine('union', \"b2\", [\"b3\"])\n    .combine('cut', \"b1\", [\"b2\", \"b3\"])\n    .sketchFeature('front', {\"points\": [{\"id\": \"O\", \"x\": 0, \"y\": 0, \"fixed\": true}, {\"id\": \"p1\", \"x\": -1.0, \"y\": -3.0}, {\"id\": \"p37\", \"x\": 1.0, \"y\": -3.0}, {\"id\": \"p38\", \"x\": 1.0, \"y\": 0.0}, {\"id\": \"p74\", \"x\": -1.0, \"y\": 0.0}, {\"id\": \"p75\", \"x\": 0.0, \"y\": -3.0}, {\"id\": \"p76\", \"x\": 0.0, \"y\": 0.0}], \"entities\": [{\"id\": \"e1\", \"type\": \"arc\", \"c\": \"p75\", \"p1\": \"p1\", \"p2\": \"p37\"}, {\"id\": \"e2\", \"type\": \"line\", \"p1\": \"p37\", \"p2\": \"p38\"}, {\"id\": \"e3\", \"type\": \"arc\", \"c\": \"p76\", \"p1\": \"p38\", \"p2\": \"p74\"}, {\"id\": \"e4\", \"type\": \"line\", \"p1\": \"p74\", \"p2\": \"p1\"}]})\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b4\", \"sketch\": \"$sketch\", \"end\": \"mid\", \"depth\": \"=microswitch_button_w\"})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b4\"}], \"translate\": [-2.8, \"=(5.8-(microswitch_button_t/2))\", 0.0]})\n    .sketch('front', (s) => { s.circle(0.8, [0, -0.5]); s.polygon([[-1.6, -1.95], [1.6, -1.95], [1.6, 1.95], [-1.6, 1.95]]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b5\", \"sketch\": \"$sketch\", \"end\": \"mid\", \"depth\": 0.5})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b5\"}], \"rotate\": {\"axis\": \"y\", \"origin\": [0, 0, 0], \"angle\": 90.0}})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b5\"}], \"translate\": [-8.05, -7.05, 0.0]})\n    .sketch('front', (s) => { s.circle(0.8, [0, -0.5]); s.polygon([[-1.6, -1.95], [1.6, -1.95], [1.6, 1.95], [-1.6, 1.95]]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b6\", \"sketch\": \"$sketch\", \"end\": \"mid\", \"depth\": 0.5})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b6\"}], \"rotate\": {\"axis\": \"y\", \"origin\": [0, 0, 0], \"angle\": 90.0}})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b6\"}], \"translate\": [0.75, -7.05, 0.0]})\n    .sketch('front', (s) => { s.circle(0.8, [0, -0.5]); s.polygon([[-1.6, -1.95], [1.6, -1.95], [1.6, 1.95], [-1.6, 1.95]]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b7\", \"sketch\": \"$sketch\", \"end\": \"mid\", \"depth\": 0.5})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b7\"}], \"rotate\": {\"axis\": \"y\", \"origin\": [0, 0, 0], \"angle\": 90.0}})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b7\"}], \"translate\": [8.05, -7.05, 0.0]})\n    .combine('union', \"b1\", [\"b4\", \"b5\", \"b6\", \"b7\"])\n    .appearance({ feature: 'F2', colour: '#333333' })\n    .appearance({ feature: 'F4', colour: '#333333' })\n    .appearance({ feature: 'F6', colour: '#333333' })\n    .appearance({ feature: 'F13', colour: '#ffdc64' })\n    .appearance({ feature: 'F17', colour: '#ffdc64' })\n    .appearance({ feature: 'F21', colour: '#ffdc64' });\n});\n","appearance":{"F2":{"color":"#333333"},"F4":{"color":"#333333"},"F6":{"color":"#333333"},"F13":{"color":"#ffdc64"},"F17":{"color":"#ffdc64"},"F21":{"color":"#ffdc64"}},"license":"GPL-3.0-or-later","source":"https://github.com/nophead/NopSCADlib/blob/00ec289/vitamins/microswitch.scad"}