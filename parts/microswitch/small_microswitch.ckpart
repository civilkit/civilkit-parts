"body":"b6"}],"rotate":{"axis":"y","origin":[0,0,0],"angle":90},"id":"F18","group":"small_microswitch"},{"type":"moveBody","bodies":[{"body":"b6"}],"translate":[0,-4.9,0],"id":"F19","group":"small_microswitch"},{"type":"sketch","id":"F20","plane":{"kind":"std","id":"front"},"points":[{"id":"O","x":0,"y":0,"fixed":true},{"id":"p1","x":-0.2,"y":-1.65},{"id":"p2","x":0.2,"y":-1.65},{"id":"p3","x":0.2,"y":1.65},{"id":"p4","x":-0.2,"y":1.65}],"entities":[{"id":"e1","type":"line","p1":"p1","p2":"p2"},{"id":"e2","type":"line","p1":"p2","p2":"p3"},{"id":"e3","type":"line","p1":"p3","p2":"p4"},{"id":"e4","type":"line","p1":"p4","p2":"p1"}],"constraints":[],"group":"small_microswitch"},{"type":"extrude","op":"newBody","body":"b7","sketch":"F20","end":"mid","depth":0.9,"id":"F21","group":"small_microswitch"},{"type":"moveBody","bodies":[{"body":"b7"}],"rotate":{"axis":"y","origin":[0,0,0],"angle":90},"id":"F22","group":"small_microswitch"},{"type":"moveBody","bodies":[{"body":"b7"}],"translate":[5.08,-4.9,0],"id":"F23","group":"small_microswitch"},{"type":"combine","op":"union","target":{"body":"b1"},"tools":[{"body":"b4"},{"body":"b5"},{"body":"b6"},{"body":"b7"}],"id":"F24","group":"small_microswitch"}],"seq":25,"rollback":null,"variables":[{"name":"microswitch_button_t","expr":"1.2"},{"name":"microswitch_button_w","expr":"2.9"},{"name":"microswitch_thickness","expr":"5.8"}],"script":"// microswitch(small_microswitch) from NopSCADlib 00ec289 (GPL-3.0-or-later); see ../NOTICE.md\n// Generated by openscad_to_ckpart.py. Edit freely: running this script rebuilds the feature history.\nvariables({ microswitch_button_t: 1.2, microswitch_button_w: 2.9, microswitch_thickness: 5.8 });\nconst p = part(\"small_microswitch\");\ngroup(\"small_microswitch\", () => {\n  p\n    .sketch('front', (s) => { s.polygon([[-6.4, -3.25], [-6.4, 3.25], [6.4, 3.25], [6.4, -3.25]]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b1\", \"sketch\": \"$sketch\", \"end\": \"mid\", \"depth\": \"=microswitch_thickness\"})\n    .sketch('front', (s) => { s.circle(1, [-3.25, -1.65]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b2\", \"sketch\": \"$sketch\", \"end\": \"mid\", \"depth\": \"=microswitch_thickness\"})\n    .sketch('front', (s) => { s.circle(1, [3.25, -1.65]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b3\", \"sketch\": \"$sketch\", \"end\": \"mid\", \"depth\": \"=microswitch_thickness\"})\n    .combine('union', \"b2\", [\"b3\"])\n    .combine('cut', \"b1\", [\"b2\", \"b3\"])\n    .sketchFeature('front', {\"points\": [{\"id\": \"O\", \"x\": 0, \"y\": 0, \"fixed\": true}, {\"id\": \"p1\", \"x\": -0.6, \"y\": -3.0}, {\"id\": \"p37\", \"x\": 0.6, \"y\": -3.0}, {\"id\": \"p38\", \"x\": 0.6, \"y\": 0.0}, {\"id\": \"p74\", \"x\": -0.6, \"y\": 0.0}, {\"id\": \"p75\", \"x\": 0.0, \"y\": -3.0}, {\"id\": \"p76\", \"x\": 0.0, \"y\": 0.0}], \"entities\": [{\"id\": \"e1\", \"type\": \"arc\", \"c\": \"p75\", \"p1\": \"p1\", \"p2\": \"p37\"}, {\"id\": \"e2\", \"type\": \"line\", \"p1\": \"p37\", \"p2\": \"p38\"}, {\"id\": \"e3\", \"type\": \"arc\", \"c\": \"p76\", \"p1\": \"p38\", \"p2\": \"p74\"}, {\"id\": \"e4\", \"type\": \"line\", \"p1\": \"p74\", \"p2\": \"p1\"}]})\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b4\", \"sketch\": \"$sketch\", \"end\": \"mid\", \"depth\": \"=microswitch_button_w\"})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b4\"}], \"translate\": [-1.95, \"=(3.75-(microswitch_button_t/2))\", 0.0]})\n    .sketch('front', (s) => { s.polygon([[-0.2, -1.65], [0.2, -1.65], [0.2, 1.65], [-0.2, 1.65]]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b5\", \"sketch\": \"$sketch\", \"end\": \"mid\", \"depth\": 0.9})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b5\"}], \"rotate\": {\"axis\": \"y\", \"origin\": [0, 0, 0], \"angle\": 90.0}})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b5\"}], \"translate\": [-5.08, -4.9, 0.0]})\n    .sketch('front', (s) => { s.polygon([[-0.2, -1.65], [0.2, -1.65], [0.2, 1.65], [-0.2, 1.65]]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b6\", \"sketch\": \"$sketch\", \"end\": \"mid\", \"depth\": 0.9})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b6\"}], \"rotate\": {\"axis\": \"y\", \"origin\": [0, 0, 0], \"angle\": 90.0}})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b6\"}], \"translate\": [0.0, -4.9, 0.0]})\n    .sketch('front', (s) => { s.polygon([[-0.2, -1.65], [0.2, -1.65], [0.2, 1.65], [-0.2, 1.65]]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b7\", \"sketch\": \"$sketch\", \"end\": \"mid\", \"depth\": 0.9})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b7\"}], \"rotate\": {\"axis\": \"y\", \"origin\": [0, 0, 0], \"angle\": 90.0}})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b7\"}], \"translate\": [5.08, -4.9, 0.0]})\n    .combine('union', \"b1\", [\"b4\", \"b5\", \"b6\", \"b7\"])\n    .appearance({ feature: 'F2', colour: '#333333' })\n    .appearance({ feature: 'F4', colour: '#333333' })\n    .appearance({ feature: 'F6', colour: '#333333' })\n    .appearance({ feature: 'F10', colour: '#ffffff' })\n    .appearance({ feature: 'F13', colour: '#ffdc64' })\n    .appearance({ feature: 'F17', colour: '#ffdc64' })\n    .appearance({ feature: 'F21', colour: '#ffdc64' });\n});\n","appearance":{"F2":{"color":"#333333"},"F4":{"color":"#333333"},"F6":{"color":"#333333"},"F10":{"color":"#ffffff"},"F13":{"color":"#ffdc64"},"F17":{"color":"#ffdc64"},"F21":{"color":"#ffdc64"}},"license":"GPL-3.0-or-later","source":"https://github.com/nophead/NopSCADlib/blob/00ec289/vitamins/microswitch.scad"}