gterm_thickness\"})\n    .combine('cut', \"b1\", [\"b3\"])\n    .sketchFeature('front', {\"points\": [{\"id\": \"O\", \"x\": 0, \"y\": 0, \"fixed\": true}, {\"id\": \"p1\", \"x\": -1.5, \"y\": -3.917157288}, {\"id\": \"p37\", \"x\": 1.5, \"y\": -3.917157288}, {\"id\": \"p38\", \"x\": 1.5, \"y\": 0.0}, {\"id\": \"p39\", \"x\": -1.5, \"y\": 0.0}, {\"id\": \"p40\", \"x\": 0.0, \"y\": -3.917157}, {\"id\": \"p41\", \"x\": 0.0, \"y\": -3.917157288}], \"entities\": [{\"id\": \"e1\", \"type\": \"arc\", \"c\": \"p40\", \"p1\": \"p1\", \"p2\": \"p37\"}, {\"id\": \"e2\", \"type\": \"line\", \"p1\": \"p37\", \"p2\": \"p38\"}, {\"id\": \"e3\", \"type\": \"line\", \"p1\": \"p38\", \"p2\": \"p39\"}, {\"id\": \"e4\", \"type\": \"line\", \"p1\": \"p39\", \"p2\": \"p1\"}, {\"id\": \"e5\", \"type\": \"circle\", \"c\": \"p41\", \"r\": 0.75}]})\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b4\", \"sketch\": \"$sketch\", \"end\": \"blind\", \"depth\": \"=ringterm_thickness\"})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b4\"}], \"rotate\": {\"axis\": \"x\", \"origin\": [0, 0, 0], \"angle\": -45.0}})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b4\"}], \"translate\": [0.0, \"=(-((washer_diameter/2)+(ringterm_thickness*0.4142135624)))\", 0.0]})\n    .combine('union', \"b1\", [\"b4\"])\n    .appearance({ feature: 'F2', colour: '#c0c0c0' })\n    .appearance({ feature: 'F4', colour: '#c0c0c0' })\n    .appearance({ feature: 'F7', colour: '#c0c0c0' })\n    .appearance({ feature: 'F10', colour: '#c0c0c0' });\n});\n","appearance":{"F2":{"color":"#c0c0c0"},"F4":{"color":"#c0c0c0"},"F7":{"color":"#c0c0c0"},"F10":{"color":"#c0c0c0"}},"license":"GPL-3.0-or-later","source":"https://github.com/nophead/NopSCADlib/blob/00ec289/vitamins/ring_terminal.scad"}