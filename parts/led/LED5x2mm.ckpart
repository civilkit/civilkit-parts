roup":"LED5x2mm"},{"type":"extrude","op":"newBody","body":"b3","sketch":"F8","end":"mid","depth":5,"id":"F9","group":"LED5x2mm"},{"type":"moveBody","bodies":[{"body":"b3"}],"translate":[0,0,2.5],"id":"F10","group":"LED5x2mm"},{"type":"moveBody","bodies":[{"body":"b3"}],"rotate":{"axis":"x","origin":[0,0,0],"angle":180},"id":"F11","group":"LED5x2mm"},{"type":"moveBody","bodies":[{"body":"b3"}],"translate":["=(((-1)*led_pitch)/2)",0,0],"id":"F12","group":"LED5x2mm"},{"type":"sketch","id":"F13","plane":{"kind":"std","id":"front"},"points":[{"id":"O","x":0,"y":0,"fixed":true},{"id":"p1","x":-0.25,"y":-0.25},{"id":"p2","x":0.25,"y":-0.25},{"id":"p3","x":0.25,"y":0.25},{"id":"p4","x":-0.25,"y":0.25}],"entities":[{"id":"e1","type":"line","p1":"p1","p2":"p2"},{"id":"e2","type":"line","p1":"p2","p2":"p3"},{"id":"e3","type":"line","p1":"p3","p2":"p4"},{"id":"e4","type":"line","p1":"p4","p2":"p1"}],"constraints":[],"group":"LED5x2mm"},{"type":"extrude","op":"newBody","body":"b4","sketch":"F13","end":"mid","depth":5,"id":"F14","group":"LED5x2mm"},{"type":"moveBody","bodies":[{"body":"b4"}],"translate":[0,0,2.5],"id":"F15","group":"LED5x2mm"},{"type":"moveBody","bodies":[{"body":"b4"}],"rotate":{"axis":"x","origin":[0,0,0],"angle":180},"id":"F16","group":"LED5x2mm"},{"type":"moveBody","bodies":[{"body":"b4"}],"translate":["=((1*led_pitch)/2)",0,0],"id":"F17","group":"LED5x2mm"},{"type":"combine","op":"union","target":{"body":"b1"},"tools":[{"body":"b3"},{"body":"b4"}],"id":"F18","group":"LED5x2mm"}],"seq":19,"rollback":null,"variables":[{"name":"led_height","expr":"7"},{"name":"led_pitch","expr":"2.54"},{"name":"led_rim_t","expr":"0.7"}],"script":"// led(LED5x2mm) from NopSCADlib 00ec289 (GPL-3.0-or-later); see ../NOTICE.md\n// Generated by openscad_to_ckpart.py. Edit freely: running this script rebuilds the feature history.\nvariables({ led_height: 7, led_pitch: 2.54, led_rim_t: 0.7 });\nconst p = part(\"LED5x2mm\");\ngroup(\"LED5x2mm\", () => {\n  p\n    .sketch('front', (s) => { s.polygon([[-2.5, -1], [2.5, -1], [2.5, 1], [-2.5, 1]]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b1\", \"sketch\": \"$sketch\", \"end\": \"mid\", \"depth\": \"=led_height\"})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b1\"}], \"translate\": [0.0, 0.0, \"=(led_height/2)\"]})\n    .sketch('front', (s) => { s.polygon([[-2.5, -1.35], [2.5, -1.35], [2.5, 1.35], [-2.5, 1.35]]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b2\", \"sketch\": \"$sketch\", \"end\": \"mid\", \"depth\": \"=led_rim_t\"})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b2\"}], \"translate\": [0.0, 0.0, \"=(led_rim_t/2)\"]})\n    .combine('union', \"b1\", [\"b2\"])\n    .sketch('front', (s) => { s.polygon([[-0.25, -0.25], [0.25, -0.25], [0.25, 0.25], [-0.25, 0.25]]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b3\", \"sketch\": \"$sketch\", \"end\": \"mid\", \"depth\": 5.0})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b3\"}], \"translate\": [0.0, 0.0, 2.5]})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b3\"}], \"rotate\": {\"axis\": \"x\", \"origin\": [0, 0, 0], \"angle\": 180.0}})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b3\"}], \"translate\": [\"=(((-1)*led_pitch)/2)\", 0.0, 0.0]})\n    .sketch('front', (s) => { s.polygon([[-0.25, -0.25], [0.25, -0.25], [0.25, 0.25], [-0.25, 0.25]]); })\n    .feature({\"type\": \"extrude\", \"op\": \"newBody\", \"body\": \"b4\", \"sketch\": \"$sketch\", \"end\": \"mid\", \"depth\": 5.0})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b4\"}], \"translate\": [0.0, 0.0, 2.5]})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b4\"}], \"rotate\": {\"axis\": \"x\", \"origin\": [0, 0, 0], \"angle\": 180.0}})\n    .feature({\"type\": \"moveBody\", \"bodies\": [{\"body\": \"b4\"}], \"translate\": [\"=((1*led_pitch)/2)\", 0.0, 0.0]})\n    .combine('union', \"b1\", [\"b3\", \"b4\"])\n    .appearance({ feature: 'F2', colour: '#ff0000' })\n    .appearance({ feature: 'F5', colour: '#ff0000' })\n    .appearance({ feature: 'F9', colour: '#c0c0c0' })\n    .appearance({ feature: 'F14', colour: '#c0c0c0' });\n});\n","appearance":{"F2":{"color":"#ff0000"},"F5":{"color":"#ff0000"},"F9":{"color":"#c0c0c0"},"F14":{"color":"#c0c0c0"}},"license":"GPL-3.0-or-later","source":"https://github.com/nophead/NopSCADlib/blob/00ec289/vitamins/led.scad"}